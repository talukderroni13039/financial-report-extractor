# Copy to .env.dev / .env.uat and fill in. Only ANTHROPIC_API_KEY is required;
# every other variable has a safe default in code.
APP_ENV=dev
LOG_LEVEL=DEBUG
ANTHROPIC_API_KEY=your-key-here
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=4000
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=300000
