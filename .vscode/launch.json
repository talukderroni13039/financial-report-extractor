{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (dev, reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.main:app", "--reload", "--port", "8000"],
      "env": { "APP_ENV": "dev" },
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "API (uat)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.main:app", "--port", "8000"],
      "env": { "APP_ENV": "uat" },
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Tests (mocked)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
